# ------------------------------------------------------------------
# DevForge client environment - frontend-only repository.
# The API lives in the separate DevForge-Api repository.
# Copy this file to .env and fill in real values.
# NEVER commit .env - it is ignored by git.
# ------------------------------------------------------------------

# --- API origin ---
# Development: leave empty - Vite proxies /api to http://localhost:4000,
# so you only need `npm run dev` in DevForge-Api.
# Production (Vercel / Netlify build): point at the deployed API, e.g.
#   VITE_API_URL=https://devforge-api.vercel.app
# (vercel.json already sets VITE_API_URL for Vercel builds.)
VITE_API_URL=

# --- Notes ---
# The API is what needs CLIENT_ORIGIN (your exact client origin, e.g.
# https://devforge.vercel.app), COOKIE_SECURE=true, COOKIE_SAME_SITE=none,
# SESSION_SECRET, and the Google/GitHub OAuth variables.
# See DevForge-Api/docs/API.md for the full setup checklist.