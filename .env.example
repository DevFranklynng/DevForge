# ------------------------------------------------------------------
# DevForge client environment — frontend-only repository.
# The API lives in the separate DevForge-Api repository and is not
# configured from this .env.
# Copy this file to .env and fill in real values.
# NEVER commit .env - it is ignored by git.
# ------------------------------------------------------------------

# --- API origin ---
# Development: leave empty — Vite proxies /api to http://localhost:4000,
# so you only need the API repo running (`npm run dev` in DevForge-Api).
# Production (Netlify build): point at the deployed API, e.g.
#   VITE_API_URL=https://devforge-api.onrender.com
VITE_API_URL=

# --- Notes ---
# The API is what needs CLIENT_ORIGIN, COOKIE_SECURE, COOKIE_SAME_SITE,
# SESSION_SECRET and the Google/GitHub OAuth variables. See DevForge-Api
# .env.example for those.