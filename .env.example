# ------------------------------------------------------------------
# DevForge environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env - it is ignored by git.
# ------------------------------------------------------------------

# --- Server ---
# Port the DevForge API listens on.
PORT=4000
# Public origin of the API. Used for CORS and cookie configuration in production.
API_URL=http://localhost:4000
# Allowed client origin(s). Comma-separated. Leave as the Vite dev origin locally.
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# DevForge uses Prisma. By default it runs on a local SQLite file that requires
# zero setup (file resolved relative to server/prisma).
#
# To use PostgreSQL instead:
#   1. Install PostgreSQL and create a database, e.g. `devforge`.
#   2. In server/prisma/schema.prisma change `provider = "sqlite"` to `provider = "postgresql"`.
#   3. Set DATABASE_URL below to your connection string, e.g.
#      postgresql://USER:PASSWORD@localhost:5432/devforge?schema=public
#   4. Run: npm run db:push   (then: npm run db:seed)
DATABASE_URL=file:./devforge.db

# --- Authentication / sessions ---
# Long random string used to sign session values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# How long a login session lasts before it must be renewed (in days).
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# --- Demo mode flags ---
# When true the app clearly labels demo/estimated repo + deployment data.
# Set to false once real integrations are configured.
DEMO_MODE=true

# --- GitHub integration (optional) ---
# A Personal Access Token (public repo read scope is enough) enables live
# repository sync. When absent, repository records are managed manually and
# clearly labelled as demo data.
GITHUB_TOKEN=
# OAuth client id/secret used for full GitHub OAuth flows (future).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Deploy provider (optional) ---
# Reserved for real deployment providers (Vercel/Railway/Fly). When unset the
# built-in simulated provider is used and every deployment is labelled as demo.
DEPLOY_PROVIDER=

# --- AI assistant ---
# DevForge AI works out of the box with a built-in demo engine that answers
# from your real workspace data (no key required).
#
# To connect an external provider set AI_PROVIDER and the matching key.
# Supported providers: "openai-aicompat" (OpenAI, OpenRouter, groq, etc.)
AI_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini